{
  "name": "lottery-whatsapp-saas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "npm run db:generate && npm run check:utf8 && turbo build",
    "start": "npm run db:generate && npm run db:deploy && npm run ensure:admins && npm --workspace @lottery/web run start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "npm --workspace @lottery/db run generate",
    "db:push": "npx prisma db push --schema packages/db/prisma/schema.prisma",
    "db:deploy": "node scripts/db-deploy.mjs",
    "ensure:admins": "node scripts/ensure-admins.mjs",
    "check:utf8": "node scripts/check-utf8-hebrew.mjs",
    "setup:dev": "powershell -ExecutionPolicy Bypass -File .\\scripts\\dev-up.ps1",
    "setup:superadmin": "node scripts/setup-superadmin.mjs",
    "reset:demo": "node scripts/reset-demo.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.12",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "next": {
      "postcss": "^8.5.10"
    }
  }
}

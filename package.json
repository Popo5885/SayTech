{
  "name": "lottery-whatsapp-saas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "npm --workspace @lottery/db run generate",
    "db:push": "npx prisma db push --schema packages/db/prisma/schema.prisma",
    "setup:dev": "powershell -ExecutionPolicy Bypass -File .\\scripts\\dev-up.ps1"
  },
  "devDependencies": {
    "turbo": "^2.0.12",
    "typescript": "^5.6.3"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WhatsAppStatus {
  CONNECTED
  DISCONNECTED
}

enum WhatsAppProviderKind {
  unofficial_qr
  official_business
}

enum AccountStatus {
  pending
  active
  suspended
  rejected
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

enum WorkspaceNumberPoolStatus {
  waiting
  assigned
}

enum WorkspaceConnectionAssignmentStatus {
  active
  released
}

enum ConnectionStatus {
  idle
  connecting
  qr_ready
  connected
  disconnected
  error
}

enum CampaignType {
  REFERRAL
  TRIGGER
}

enum DrawWeightMode {
  ONE_PER_PARTICIPANT
  STORED_TICKETS
  REFERRALS_HALVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ParticipantOnboardingState {
  AWAITING_NAME
  AWAITING_EMAIL
  AWAITING_REFERRER
  AWAITING_STATUS_PROOF
  AWAITING_CONTACT_SAVED
  REGISTERED
}

enum TemplateInteractiveType {
  NONE
  BUTTONS
  LIST
}

enum MessageTemplateType {
  WELCOME
  EMAIL_PROMPT
  REFERRER_PROMPT
  SAVE_CONTACT_PROMPT
  REGISTRATION_PAUSED
  MAIN_MENU
  LINK
  GROUP_INVITE
  JOIN_WHATSAPP_PROMPT
  STATUS
  WINNER
  SELF_STATUS
  REFERRAL_UPDATE
  LEADERBOARD_SUMMARY
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  queued
  sent
  failed
  received
}

enum ContactDeliveryMode {
  CONTACT_CARD
  VCARD_FILE
}

enum ContactLeadStatus {
  open
  converted
  closed
}

enum ContactSyncStatus {
  saved_system
  synced_google
  duplicate
  quota_exceeded
  pending_google
}

enum ContactBotUpgradeStatus {
  open
  approved
  rejected
  closed
}

enum EmailTemplateKind {
  PENDING_USER
  OWNER_APPROVAL
  APPROVED_USER
  REJECTED_USER
  RESET_CODE
  CONTACT_LEAD_USER
  CONTACT_LEAD_OWNER
  NEWSLETTER
}

enum EmailDeliveryStatus {
  draft
  queued
  sent
  failed
  skipped
}

model Workspace {
  id                          String               @id @default(cuid())
  name                        String
  slug                        String               @unique
  ownerName                   String?
  ownerEmail                  String?              @unique
  accountStatus               AccountStatus        @default(pending)
  maxCampaigns                Int                  @default(1)
  monthlyMessageLimit         Int?
  hasTelegramSupport          Boolean              @default(false)
  contractSignedAt            DateTime?
  phoneNumber                 String?
  whatsappStatus              WhatsAppStatus       @default(DISCONNECTED)
  googleSubject               String?              @unique
  googleAccessTokenEncrypted  String?              @db.Text
  googleRefreshTokenEncrypted String?              @db.Text
  googleTokenExpiry           DateTime?
  googleContactTemplate       String               @default("{{name}}+בוט")
  contactBotBaseQuota         Int                  @default(600)
  contactBotExtraQuota        Int                  @default(0)
  contactBotUsedQuota         Int                  @default(0)
  contactBotMonthlyPriceCents Int                  @default(5000)
  enabledModules              String[]             @default(["core"])
  numberPoolStatus            WorkspaceNumberPoolStatus @default(waiting)
  onboardingTourStep          Int                  @default(0)
  onboardingTourCompletedAt   DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  connections                 WhatsAppConnection[]
  connectionAssignments       WorkspaceConnectionAssignment[]
  campaigns                   Campaign[]
  contactSyncLedger           ContactSyncLedger[]
  contactBotQuotaAdjustments  ContactBotQuotaAdjustment[]
  contactBotUpgradeRequests   ContactBotUpgradeRequest[]
  members                     WorkspaceMember[]
  invites                     WorkspaceInvite[]
  contactCards                WorkspaceContactCard[]
  automationRules             AutomationRule[]
  billingRecords              BillingRecord[]
  affiliateReferralsMade      AffiliateReferral[] @relation("AffiliateReferrerWorkspace")
  affiliateReferralsReceived  AffiliateReferral[] @relation("AffiliateReferredWorkspace")
  affiliatePointsLedger       AffiliatePointsLedger[]
  affiliatePointsBalance      AffiliatePointsBalance?
  affiliateRedemptions        AffiliateRedemption[]
  messageLogs                 MessageLog[]
}

model WhatsAppConnection {
  id           String               @id @default(cuid())
  workspaceId  String
  provider     WhatsAppProviderKind
  label        String
  status       ConnectionStatus     @default(idle)
  maxTenants   Int                  @default(3)
  currentTenants Int                @default(0)
  batteryLevel Int?
  qrCode       String?
  phoneNumber  String?
  sessionKey   String               @unique
  officialPhoneNumberId String?
  officialWabaId        String?
  officialAccessTokenEncrypted String? @db.Text
  officialWebhookVerifyTokenEncrypted String? @db.Text
  lastError    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments  WorkspaceConnectionAssignment[]
  campaigns    Campaign[]
  messageLogs  MessageLog[]

  @@index([workspaceId])
  @@index([provider])
  @@index([status])
}

model Campaign {
  id                   String              @id @default(cuid())
  workspaceId          String
  connectionId         String
  name                 String
  slug                 String              @unique
  type                 CampaignType
  triggerWord          String?
  drawDate             DateTime?
  drawWeightMode       DrawWeightMode      @default(ONE_PER_PARTICIPANT)
  contactTagName       String              @default("Lottery_Campaign_1")
  googleContactGroupResourceName String?
  statusCommandAliases String[]
  isActive             Boolean             @default(true)
  collectEmail         Boolean             @default(false)
  groupInviteLink      String?
  messageCount         Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection           WhatsAppConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  participants         Participant[]
  templates            MessageTemplate[]
  winnerDraws          WinnerDraw[]
  messageLogs          MessageLog[]

  @@index([workspaceId])
  @@index([connectionId])
  @@index([type])
  @@index([triggerWord])
}

model Participant {
  id                   String                     @id @default(cuid())
  campaignId           String
  phone                String
  chatAddress          String?
  name                 String?
  referralCode         String
  referralLink         String
  referrerId           String?
  onboardingState      ParticipantOnboardingState @default(REGISTERED)
  contactSavedConfirmed Boolean                   @default(true)
  statusProofReceived  Boolean                    @default(false)
  statusProofMediaUrl  String?                    @db.Text
  email                String?
  pendingReferralCode  String?
  pendingReferrerPhone String?
  tickets              Int                        @default(1)
  referralsCount       Int                        @default(0)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  campaign             Campaign                   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  referrer             Participant?               @relation("ParticipantReferrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals            Participant[]              @relation("ParticipantReferrals")
  winnerDraws          WinnerDraw[]
  messageLogs          MessageLog[]

  @@unique([campaignId, phone])
  @@unique([campaignId, referralCode])
  @@index([campaignId])
  @@index([campaignId, chatAddress])
  @@index([referrerId])
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  name                String?
  fullName            String?
  phone               String?
  passwordHash        String?
  accountStatus       AccountStatus @default(pending)
  globalRole          GlobalRole    @default(USER)
  googleSubject       String?       @unique
  acceptedTermsAt     DateTime?
  acceptedPrivacyAt   DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  suspendedAt         DateTime?
  lastLoginAt         DateTime?
  emailUnsubscribedAt DateTime?
  unsubscribeToken    String        @unique @default(cuid())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  memberships         WorkspaceMember[]
  invitesSent         WorkspaceInvite[] @relation("InviteSender")
  passwordResetTokens PasswordResetToken[]

  @@index([accountStatus])
  @@index([globalRole])
  @@index([phone])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
}

model WorkspaceInvite {
  id          String       @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  status      InviteStatus @default(pending)
  tokenHash   String       @unique
  invitedByUserId String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User?        @relation("InviteSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@index([status])
}

model WorkspaceConnectionAssignment {
  id           String             @id @default(cuid())
  workspaceId  String
  connectionId String
  status       WorkspaceConnectionAssignmentStatus @default(active)
  assignedByUserId String?
  assignedAt   DateTime           @default(now())
  releasedAt   DateTime?
  createdAt    DateTime           @default(now())
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection    WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, connectionId])
  @@index([workspaceId])
  @@index([connectionId])
  @@index([workspaceId, status])
  @@index([connectionId, status])
}

model WorkspaceContactCard {
  id          String      @id @default(cuid())
  workspaceId String
  displayName String
  phone       String
  organization String?
  sortOrder   Int         @default(0)
  isEnabled   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([isEnabled])
}

model MessageLog {
  id                String                @id @default(cuid())
  workspaceId       String
  campaignId        String?
  connectionId      String
  participantId     String?
  direction         MessageDirection
  status            MessageDeliveryStatus @default(queued)
  providerMessageId String?
  body              String?               @db.Text
  errorMessage      String?               @db.Text
  createdAt         DateTime              @default(now())
  sentAt            DateTime?
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign          Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  connection        WhatsAppConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  participant       Participant?          @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([campaignId, createdAt])
  @@index([connectionId, createdAt])
  @@index([direction, status])
}

model MessageTemplate {
  id         String                  @id @default(cuid())
  campaignId String
  type       MessageTemplateType
  label      String?
  /// WhatsApp template content with placeholders like {{name}}, {{tickets}}, {{link}}
  content    String                  @db.Text
  isEnabled  Boolean                 @default(true)
  mediaUrl   String?                 @db.Text
  mediaType  MediaType?
  interactiveType TemplateInteractiveType @default(NONE)
  interactiveData Json?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, type])
  @@index([campaignId])
}

model ContactSyncLedger {
  id                       String    @id @default(cuid())
  workspaceId              String
  phone                    String
  displayName              String
  googlePersonResourceName String?
  lastCampaignId           String?
  status                   ContactSyncStatus @default(saved_system)
  quotaCounted             Boolean   @default(false)
  syncedAt                 DateTime?
  lastCheckedAt            DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
  @@index([workspaceId])
  @@index([lastCampaignId])
  @@index([workspaceId, status])
}

model ContactBotQuotaAdjustment {
  id              String    @id @default(cuid())
  workspaceId     String
  amount          Int
  priceCents      Int       @default(0)
  note            String?   @db.Text
  createdByUserId String?
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdAt])
}

model ContactBotUpgradeRequest {
  id                  String                  @id @default(cuid())
  workspaceId         String
  requestedContacts   Int                     @default(100)
  requestedPacks      Int                     @default(1)
  estimatedPriceCents Int                     @default(500)
  status              ContactBotUpgradeStatus @default(open)
  note                String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  closedAt            DateTime?
  workspace           Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

model WhatsAppLoginCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model ContactLead {
  id              String            @id @default(cuid())
  fullName        String
  email           String
  phone           String?
  message         String?           @db.Text
  acceptedTermsAt DateTime?
  acceptedPrivacyAt DateTime?
  status          ContactLeadStatus @default(open)
  convertedUserId String?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailTemplate {
  id        String            @id @default(cuid())
  kind      EmailTemplateKind @unique
  subject   String
  body      String            @db.Text
  isEnabled Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model EmailBroadcast {
  id          String              @id @default(cuid())
  subject     String
  body        String              @db.Text
  audience    String              @default("active_users")
  status      EmailDeliveryStatus @default(draft)
  sentAt      DateTime?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AutomationRule {
  id              String    @id @default(cuid())
  workspaceId     String?
  name            String
  triggerKind     String
  message         String    @db.Text
  audience        String    @default("campaign_participants")
  scheduledAt     DateTime?
  delayMinutes    Int?
  isEnabled       Boolean   @default(true)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([triggerKind])
  @@index([scheduledAt])
  @@index([isEnabled])
}

model BillingRecord {
  id              String    @id @default(cuid())
  workspaceId     String
  label           String
  amountCents     Int
  status          String    @default("draft")
  receiptNumber   String?
  receiptUrl      String?   @db.Text
  paidAt          DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

model SiteSetting {
  key             String   @id
  value           String   @db.Text
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  targetType   String
  targetId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model WinnerDraw {
  id               String      @id @default(cuid())
  campaignId       String
  participantId    String
  participantName  String
  participantPhone String
  createdAt        DateTime    @default(now())
  campaign         Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([participantId])
}

// ── Affiliate & Points ────────────────────────────────────────────────────────

/// Source of a points credit event.
enum PointsSource {
  payment_webhook   // 20 pts credited on verified payment (only source that grants points)
  manual_admin      // manual grant by SUPER_ADMIN
  referral_bonus    // future: bonus points for referral milestones
  redemption         // debit when points are redeemed for invoice credit
}

enum AffiliateReferralStatus {
  pending
  converted
  paid
  rejected
}

/// SaaS-level referral tracking between workspaces.
/// Paid conversions can award 20 points through AffiliatePointsLedger.
model AffiliateReferral {
  id                  String                  @id @default(cuid())
  referrerWorkspaceId String
  referredWorkspaceId String?
  referredEmail       String?
  referralCode        String?
  status              AffiliateReferralStatus @default(pending)
  convertedAt         DateTime?
  paidAt              DateTime?
  pointsAwarded       Int                     @default(0)
  billingRecordId     String?
  metadata            Json?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  referrerWorkspace   Workspace               @relation("AffiliateReferrerWorkspace", fields: [referrerWorkspaceId], references: [id], onDelete: Cascade)
  referredWorkspace   Workspace?              @relation("AffiliateReferredWorkspace", fields: [referredWorkspaceId], references: [id], onDelete: SetNull)

  @@index([referrerWorkspaceId])
  @@index([referredWorkspaceId])
  @@index([status])
  @@index([referralCode])
  @@index([billingRecordId])
}

/// Immutable ledger row — one row per credit/debit event.
model AffiliatePointsLedger {
  id                    String       @id @default(cuid())
  workspaceId           String
  /// Positive = credit, negative = debit (redemption).
  deltaPoints           Int
  source                PointsSource
  /// Links back to the BillingRecord that triggered this credit (payment_webhook only).
  billingRecordId       String?
  /// Optional note for audit / admin display.
  note                  String?
  createdAt             DateTime     @default(now())
  workspace             Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([source])
  @@index([createdAt])
  @@index([billingRecordId])
}

/// Snapshot of a workspace's redeemable balance (updated transactionally).
/// Formula: 100 points = 100 NIS discount on next invoice.
model AffiliatePointsBalance {
  workspaceId   String    @id
  totalPoints   Int       @default(0)
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Redemption requests (created when user requests a discount).
model AffiliateRedemption {
  id               String    @id @default(cuid())
  workspaceId      String
  pointsRedeemed   Int
  /// Amount in agorot (Israeli cents). 100 pts → 10000 agorot = 100 NIS.
  discountAgorot   Int
  status           String    @default("pending") // pending | applied | cancelled
  billingRecordId  String?   // linked when discount is applied to an invoice
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/**",
      "/scripts/**",
      "/package.json",
      "/package-lock.json",
      "/railway.json",
      "/railpack.json",
      "/Procfile",
      "/turbo.json",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@lottery/core/*": [
        "packages/core/src/*"
      ],
      "@lottery/core": [
        "packages/core/src/index"
      ],
      "@lottery/db": [
        "packages/db/src/index"
      ],
      "@lottery/ui": [
        "packages/ui/src/index"
      ],
      "@lottery/ui/*": [
        "packages/ui/src/*"
      ]
    }
  }
}
